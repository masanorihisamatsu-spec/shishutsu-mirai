# このファイルをコピーして .env を作成してください（任意）。
# 値を設定しなくても docker compose up はこのファイルのデフォルト値相当で起動します。
#
#   cp .env.example .env

# ---- Backend (FastAPI) ----
DATABASE_URL=sqlite:///./database/app.db
BACKEND_PORT=8000

# OCR（Tesseract）の認識言語・ページ分割モード。通常は変更不要（既定値: jpn / 6）。
# 精度検証時のみ設定する（比較用ツール: backend/scripts/ocr_compare.py）。
# OCR_LANG=jpn
# OCR_PSM=6
# OCR_DEBUG_SAVE_PREPROCESSED=false

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
